# Copy this file to .env and fill in real values. Never commit .env.
DATABASE_URL=postgresql://casenext:casenext_dev_pw@localhost:5432/casenext_dev
FLASK_APP=run.py
FLASK_DEBUG=1
SECRET_KEY=dev-secret-key-change-me

# Used by fetch_reddit_posts.py. Reddit blocks generic User-Agents; set
# this to something identifying, e.g. "CaseNext/0.1 (by /u/yourusername)".
REDDIT_USER_AGENT=CaseNext/0.1 (academic integrity research script)
